#!/bin/bash

set -e

SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
cd "${SCRIPT_PATH}/.."

if [ ! -d env ]; then
    echo "env/ not found. Run ./script/bootstrap first."
    exit 1
fi

. env/bin/activate

proviso --extras dev --header="# DO NOT EDIT THIS FILE DIRECTLY - use ./script/update-requirements to update" "$@"
